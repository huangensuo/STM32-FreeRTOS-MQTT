# Server / cloud function environment variables
# 复制为 .env 后填写真实值，.env 不要提交到 GitHub。

ONENET_ACCESS_KEY=your_onenet_access_key
ONENET_PRODUCT_ID=your_product_id
ONENET_PID=your_product_id
ONENET_DEVICE_NAME=stm32_env_monitor
ONENET_DEV=stm32_env_monitor
ONENET_USER_ID=your_onenet_user_id
ONENET_BASE_URL=https://iot-api.heclouds.com

MQTT_BROKER=your_product_id.mqtts.acc.cmcconenet.cn
MQTT_PORT=1883
MQTT_USERNAME=your_product_id
MQTT_PASSWORD=your_onenet_mqtt_token
MQTT_CLIENT_ID=stm32_ai_server

ONENET_DEVICE_KEY=your_onenet_device_key
EMQX_BROKER=broker.emqx.io
EMQX_PORT=1883
EMQX_TOPIC=

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions