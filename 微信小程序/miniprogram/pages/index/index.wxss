.page {
  padding: 20rpx 16rpx 40rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.header-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.online {
  background: #4CAF50;
  box-shadow: 0 0 8rpx #4CAF50;
}

.status-dot.offline {
  background: #ff4757;
  box-shadow: 0 0 8rpx #ff4757;
}

.cards-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  align-items: stretch;
  width: 100%;
}

.card {
  flex: 1;
  min-width: 0;
  width: 0;
  border-radius: 16rpx;
  padding: 36rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.card-purple {
  background: linear-gradient(135deg, #a18cd1, #7c4dff);
}

.card-cyan {
  background: linear-gradient(135deg, #4dd0e1, #00bcd4);
}

.card-orange {
  background: linear-gradient(135deg, #ffb74d, #ff8f00);
}

.card-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.2;
}

.card-unit {
  font-size: 28rpx;
  font-weight: normal;
  color: rgba(255,255,255,0.8);
  margin-left: 4rpx;
}

.card-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  line-height: 1;
}

.status-list {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 0 80rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-item:last-child {
  border-bottom: none;
}

.status-name {
  font-size: 30rpx;
  color: #333;
}

.status-tag {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-tag.ok {
  color: #4CAF50;
  background: #e8f5e9;
}

.status-tag.warn {
  color: #ff4757;
  background: #ffebee;
}

.status-tag.danger {
  color: #ffffff;
  background: #ff4757;
}

.status-tag.notice {
  color: #8a5a00;
  background: #fff3cd;
}

.ai-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.ai-box {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.ai-badge {
  font-size: 24rpx;
  color: #ffffff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.ai-badge.ok {
  background: #4CAF50;
}

.ai-badge.notice {
  background: #f5a623;
}

.ai-badge.warn {
  background: #2979ff;
}

.ai-badge.danger {
  background: #ff4757;
}

.ai-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.control-section {
  margin-bottom: 20rpx;
}

.control-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.ctrl-btn:active {
  background: #f0f0f0;
}

.ctrl-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.ctrl-text {
  font-size: 26rpx;
  color: #555;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.action-btn:active {
  opacity: 0.85;
}

.action-btn-left {
  background: #ffffff;
}

.action-btn-right {
  background: #4CAF50;
}

.action-btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: bold;
}

.action-btn-left .action-btn-text {
  color: #333;
}

.action-btn-right .action-btn-text {
  color: #ffffff;
}

.footer-time {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 20rpx;
}
